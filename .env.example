# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

# Sandbox business accounts used as payees (leave blank to pay the app's own merchant)
SELLER_MEERA_EMAIL=
SELLER_ARJUN_EMAIL=
SELLER_FATIMA_EMAIL=

# Postgres (local: postgres://postgres:postgres@localhost:5432/mandi)
DATABASE_URL=

# AI and data
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CHANNEL3_API_KEY=

# Optional
# MANDI_MODEL=claude-sonnet-5-5        # Claude model for agents (default: latest Sonnet, per the plan)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# MANDI_TURN_DELAY_MS=600              # pause between turns so viewers can read them
# MANDI_FAKE_AI=1                      # skip Claude; agents use the rule-based fallback
