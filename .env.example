# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

# Sandbox personal account shown to judges next to the PayPal button (test money only)
NEXT_PUBLIC_DEMO_BUYER_EMAIL=
NEXT_PUBLIC_DEMO_BUYER_PASSWORD=

# Pay each seller's PayPal account directly instead of the Mandix merchant (off by
# default; if PayPal refuses a seller as payee, the order falls back to Mandix).
# PAYPAL_PAY_SELLERS_DIRECTLY=1
# Sandbox business accounts used as payees when that is on
SELLER_MEERA_EMAIL=
SELLER_ARJUN_EMAIL=
SELLER_FATIMA_EMAIL=

# Connect PayPal for sellers (PayPal Partner Referrals). Needs a sandbox
# *Platform* app; leave blank to hide the button (sellers enter an email instead).
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=
# PAYPAL_PARTNER_MERCHANT_ID=          # the platform's merchant id (looked up if blank)

# Logins
SESSION_SECRET=                        # 32+ random characters; required in production
# DEMO_PASSWORD=                       # password for the seeded demo logins (default in lib/auth/demo.ts)
# DEMO_LOGINS=0                        # turn off the one-click demo logins
# RESEND_API_KEY= / MAIL_FROM=         # email password-reset links (otherwise they're logged)

# Postgres (local: postgres://postgres:postgres@localhost:5432/mandix)
DATABASE_URL=

# AI and data
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CHANNEL3_API_KEY=

# Optional
# MANDIX_MODEL=claude-sonnet-5-5        # Claude model for agents (default: latest Sonnet, per the plan)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# MANDIX_TURN_DELAY_MS=600              # pause between turns so viewers can read them
# MANDIX_FAKE_AI=1                      # skip Claude; agents use the rule-based fallback
# NEXT_PUBLIC_MANDIX_GBP_INR=125        # fallback ₹ rate if the live ECB rate can't be fetched
# MANDIX_SHIP_WINDOW_MINUTES=10         # demo only: auto-void holds after this instead of the seller's ship-by days
# CRON_SECRET=                         # required in production to call POST /api/cron/void-expired
# MANDIX_MAX_SELLER_DEBT_MINOR=5000    # most a seller may owe for refunds made after their payout (pence)

# WhatsApp alerts for sellers (Twilio). Leave blank to record messages in the
# app instead of sending them. Sandbox "from" number: whatsapp:+14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public address used in links inside WhatsApp messages (Render sets
# RENDER_EXTERNAL_URL automatically).
APP_URL=
