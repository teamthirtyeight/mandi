# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

# Sandbox personal account shown to judges next to the PayPal button (test money only)
NEXT_PUBLIC_DEMO_BUYER_EMAIL=
NEXT_PUBLIC_DEMO_BUYER_PASSWORD=

# Sandbox business accounts used as payees (leave blank to pay the app's own merchant)
SELLER_MEERA_EMAIL=
SELLER_ARJUN_EMAIL=
SELLER_FATIMA_EMAIL=

# Logins
SESSION_SECRET=                        # 32+ random characters; required in production
# DEMO_PASSWORD=                       # password for the seeded demo logins (default in lib/auth/demo.ts)
# DEMO_LOGINS=0                        # turn off the one-click demo logins

# Postgres (local: postgres://postgres:postgres@localhost:5432/mandi)
DATABASE_URL=

# AI and data
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CHANNEL3_API_KEY=

# Optional
# MANDI_MODEL=claude-sonnet-5-5        # Claude model for agents (default: latest Sonnet, per the plan)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# MANDI_TURN_DELAY_MS=600              # pause between turns so viewers can read them
# MANDI_FAKE_AI=1                      # skip Claude; agents use the rule-based fallback
# NEXT_PUBLIC_MANDI_GBP_INR=112        # display rate for the seller's rupee view; set to the current rate
# MANDI_SHIP_WINDOW_MINUTES=10         # demo only: auto-void holds after this instead of the seller's ship-by days
# CRON_SECRET=                         # protects POST /api/cron/void-expired
